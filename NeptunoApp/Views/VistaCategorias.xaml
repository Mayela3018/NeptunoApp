<UserControl x:Class="NeptunoApp.Views.VistaCategorias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gestión de Categorías" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content=" Nueva Categoría" Background="#3498DB" Foreground="White" 
                        Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Command="{Binding LimpiarCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Tabla de Datos -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      RowHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#ECF0F1"/>
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60"/>
                    <DataGridTextColumn Header="Nombre Categoría" Binding="{Binding NombreCategoria}" Width="200"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Nombre de la Categoría" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox Text="{Binding CategoriaSeleccionada.NombreCategoria, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Descripción" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox Text="{Binding CategoriaSeleccionada.Descripcion, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Content="💾 Guardar" Background="#2ECC71" Foreground="White" 
                            Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Command="{Binding GuardarCommand}" Margin="0,0,10,0"/>
                    <Button Content="🗑️ Eliminar" Background="#E74C3C" Foreground="White" 
                            Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Command="{Binding EliminarCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>