<UserControl x:Class="NeptunoApp.Views.VistaPedidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#B8A9C9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <TextBlock Text="Gestión de Pedidos y Reportes" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- Tab 1: CRUD de Pedidos -->
            <TabItem Header="📋 Mantenimiento de Pedidos" FontSize="14" FontWeight="Bold" Padding="15,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tabla de Pedidos -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding Pedidos}" 
                                  SelectedItem="{Binding PedidoSeleccionado}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECF0F1"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pedido ID" Binding="{Binding PedidoID}" Width="80"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Empresa}" Width="200"/>
                                <DataGridTextColumn Header="Fecha Pedido" Binding="{Binding FechaPedido, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                <DataGridTextColumn Header="Empleado" Binding="{Binding EmpleadoNombre}" Width="150"/>
                                <DataGridTextColumn Header="Ciudad Destino" Binding="{Binding CiudadDestino}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Formulario CRUD -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 1: Cliente, Empleado, Transportista -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Cliente" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <ComboBox ItemsSource="{Binding Clientes}" 
                                              SelectedValue="{Binding PedidoSeleccionado.ClienteID, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="ClienteID"
                                              DisplayMemberPath="Empresa"
                                              Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <TextBlock Text="Empleado" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <ComboBox ItemsSource="{Binding Empleados}" 
                                              SelectedValue="{Binding PedidoSeleccionado.EmpleadoID, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="EmpleadoID"
                                              DisplayMemberPath="NombreCompleto"
                                              Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Transportista" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <ComboBox ItemsSource="{Binding Transportistas}" 
                                              SelectedValue="{Binding PedidoSeleccionado.TransportistaID, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="TransportistaID"
                                              DisplayMemberPath="CompaniaNombre"
                                              Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 2: Fechas -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Fecha Pedido" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <DatePicker SelectedDate="{Binding PedidoSeleccionado.FechaPedido, UpdateSourceTrigger=LostFocus}" 
                                                Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <TextBlock Text="Fecha Requerida" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <DatePicker SelectedDate="{Binding PedidoSeleccionado.FechaRequerida, UpdateSourceTrigger=LostFocus}" 
                                                Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Fecha Envío" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <DatePicker SelectedDate="{Binding PedidoSeleccionado.FechaEnvio, UpdateSourceTrigger=LostFocus}" 
                                                Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 3: Destinatario, Ciudad, País y Botones -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Destinatario" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <TextBox Text="{Binding PedidoSeleccionado.Destinatario, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <TextBlock Text="Ciudad Destino" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <TextBox Text="{Binding PedidoSeleccionado.CiudadDestino, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="País Destino" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                                    <TextBox Text="{Binding PedidoSeleccionado.PaisDestino, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                    <Button Content="➕ Nuevo" Background="#3498DB" Foreground="White" 
                                            Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding LimpiarCommand}" Margin="0,0,5,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="💾 Guardar" Background="#2ECC71" Foreground="White" 
                                            Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding GuardarCommand}" Margin="0,0,5,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="🗑️ Eliminar" Background="#E74C3C" Foreground="White" 
                                            Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding EliminarCommand}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Reporte por Fechas -->
            <TabItem Header="📊 Reporte por Fechas" FontSize="14" FontWeight="Bold" Padding="15,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros de Fecha -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="📅 Fecha Inicio:" VerticalAlignment="Center" 
                                       FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FechaInicio}" 
                                        Width="150" Padding="5" Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="2" Text="📅 Fecha Fin:" VerticalAlignment="Center" 
                                       FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding FechaFin}" 
                                        Width="150" Padding="5" Margin="0,0,20,0"/>

                            <Button Grid.Column="4" Content="🔍 Generar Reporte" 
                                    Background="#9B59B6" Foreground="White"
                                    Padding="20,10" FontSize="14" FontWeight="Bold" 
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                                    Command="{Binding GenerarReporteCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tabla de Detalle de Pedidos -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding DetallePedidos}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  RowHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#9B59B6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pedido ID" Binding="{Binding PedidoID}" Width="80"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="200"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="180"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnidad, StringFormat={}{0:C2}}" Width="100"/>
                                <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat={}{0:P0}}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>