<UserControl x:Class="NeptunoApp.Views.VistaProveedores"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#B8A9C9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gestión de Proveedores" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content=" Nuevo Proveedor" Background="#3498DB" Foreground="White" 
                        Padding="15,10" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Command="{Binding LimpiarCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Filtros de Búsqueda -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="🔍 Buscar por Nombre de Contacto" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="🏙️ Buscar por Ciudad" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla de Datos -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      RowHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#ECF0F1"/>
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="60"/>
                    <DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="200"/>
                    <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="150"/>
                    <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="150"/>
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="120"/>
                    <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="100"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Formulario CRUD Completo -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Compañía, Contacto, Cargo -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nombre de la Compañía" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Nombre de Contacto" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.NombreContacto, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Cargo del Contacto" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.CargoContacto, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Dirección" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.Direccion, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Ciudad" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.Ciudad, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Código Postal" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.CodigoPostal, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="País" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.Pais, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Teléfono" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.Telefono, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"
                                 PreviewTextInput="PhoneValidationTextBox"
                                 ToolTip="Solo se permiten números y guiones (ej: 054-223344)">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Fax" FontWeight="Bold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding ProveedorSeleccionado.Fax, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Content="💾 Guardar" Background="#2ECC71" Foreground="White" 
                                Padding="20,12" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                Command="{Binding GuardarCommand}" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="🗑️ Eliminar" Background="#E74C3C" Foreground="White" 
                                Padding="20,12" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                Command="{Binding EliminarCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>